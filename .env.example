# Database Configuration
# Default for Docker Compose local (Port 5433)
DATABASE_URL=postgresql://user:password@localhost:5433/modocolab

# Security
# CHANGE THIS IN PRODUCTION!
SECRET_KEY=dev_secret_change_me_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Sentry DSN (for error tracking)
# SENTRY_DSN=

# Email (Mailtrap for dev — https://mailtrap.io)
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@modocolab.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_STARTTLS=True

# Base URL for verification links
APP_BASE_URL=http://localhost:8000
